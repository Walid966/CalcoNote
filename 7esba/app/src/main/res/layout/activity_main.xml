<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        style="@style/Stack"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="22dp">

        <LinearLayout style="@style/Row" android:gravity="center_vertical">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_brand_mark"
                android:gravity="center"
                android:text="@string/brand_mark"
                android:textColor="@color/paper"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_status_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/topbar_note"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.18"
            android:text="@string/eyebrow"
            android:textColor="@color/coral"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hero_title"
            android:textColor="@color/ink"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/MutedText"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="@string/hero_copy"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/calculatorPanel"
            style="@style/Card">

            <LinearLayout style="@style/Row" android:gravity="center_vertical">

                <LinearLayout
                    style="@style/Stack"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView style="@style/SectionKicker" android:text="@string/current_calc_kicker" />

                    <TextView style="@style/SectionTitle" android:text="@string/current_calc_title" />
                </LinearLayout>

                <Button
                    android:id="@+id/historyToggle"
                    style="@style/TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_history_toggle"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/history_toggle"
                    android:textColor="@color/forest_deep"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/clearAll"
                    style="@style/TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_clear"
                    android:text="⌫"
                    android:textColor="@color/ink"
                    android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_display"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/expressionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:text="@string/ready_placeholder"
                    android:textColor="@color/display_expression"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/displayValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:text="0"
                    android:textColor="@color/forest_deep"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lastResultRow"
                style="@style/Row"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_last_result"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/last_result_label"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lastResultValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/noteField"
                style="@style/Stack"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_note_field"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/noteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/note_field_current"
                    android:textColor="@color/coral"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/noteInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/note_hint_current"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:minLines="1"
                    android:paddingTop="4dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keypad"
                style="@style/Stack"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/keyboardHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/keyboard_hint"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/notesPanel"
            style="@style/Card.Notes"
            android:layout_marginTop="14dp">

            <LinearLayout style="@style/Row" android:gravity="center_vertical">

                <LinearLayout
                    style="@style/Stack"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView style="@style/SectionKicker" android:text="@string/notes_kicker" />

                    <TextView style="@style/SectionTitle" android:text="@string/notes_title" />
                </LinearLayout>

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_notes_mark"
                    android:gravity="center"
                    android:text="✎"
                    android:textColor="@color/coral"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/MutedText"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:text="@string/notes_helper" />

            <LinearLayout
                android:id="@+id/draftLedger"
                style="@style/Stack"
                android:background="@drawable/bg_ledger"
                android:minHeight="135dp"
                android:padding="12dp" />
        </LinearLayout>

<LinearLayout
            android:id="@+id/historyPanel"
            style="@style/Card.History"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <LinearLayout style="@style/Row" android:gravity="center_vertical">

                <LinearLayout
                    style="@style/Stack"
                    android:layout_width="0dp"
                    android:layout_weight="1">

                    <TextView style="@style/SectionKicker" android:text="@string/history_kicker" />

                    <TextView style="@style/SectionTitle" android:text="@string/history_title" />
                </LinearLayout>

                <TextView
                    android:id="@+id/historyCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:gravity="center"
                    android:minWidth="30dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="0"
                    android:textColor="@color/badge_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/closeHistory"
                    style="@style/TextButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_close_history"
                    android:text="×"
                    android:textColor="@color/ink"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyList"
                style="@style/Stack"
                android:layout_marginTop="14dp" />

            <Button
                android:id="@+id/clearHistory"
                style="@style/TextButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/clear_history"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            style="@style/Row"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_notes_mark"
                android:gravity="center"
                android:text="✎"
                android:textColor="@color/coral"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:lineSpacingExtra="3dp"
                android:text="@string/tip_copy"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout style="@style/Row" android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_note"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
